# Learnova AI Backend Environment Configuration
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=optional_openai_key_here

# AI Provider Settings: cloud | local
AI_PROVIDER=cloud

# Google Gemini Models
CLOUD_AI_MODEL=gemini-3.5-flash
CLOUD_AI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Privacy Controls
ALLOW_CLOUD_PROCESSING=true
LOCAL_AI_ENABLED=false
